# Application
APP_NAME=Forecasting Engine
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

# Sample data
SAMPLE_DATA_FILE=data/sample/business_demand.csv
SAMPLE_DATA_SEED=42

# AI / LLM layer (OFF by default - the app uses rule-based briefs without it)
# Set AI_ENABLED=true AND OPENAI_API_KEY to turn the LLM interpretation on.
OPENAI_API_KEY=
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=800

# Logging
LOG_LEVEL=INFO
